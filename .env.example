# Cloudflare Account (for Workers/D1 deployment)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

# Admin Authentication
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_key
WHATSAPP_NUMBER=919876543210

# Cloudflare D1 Database
DATABASE_ID=your_d1_database_id

# Tigris Object Storage (replaces Cloudflare R2)
TIGRIS_ENDPOINT_URL=https://t3.storage.dev
TIGRIS_ACCESS_KEY_ID=your_tigris_access_key_id
TIGRIS_SECRET_ACCESS_KEY=your_tigris_secret_access_key
TIGRIS_BUCKET=lonecrafts-media
